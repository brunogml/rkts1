  <item>
    <coll>Go</coll>
    <ref>Go06,03</ref>
    <rnb>17</rnb>
    <tib>gcung me'u dga' bo mngal du 'jug pa bstand pa</tib>
    <skt/>
    <coloph/>
    <colophTitle/>
    <margin/>
    <note>Dedication: &#13;
&lt;br&gt;&lt;i&gt;ri mtho' sa rtsang spu rgyal bod kyi yul || &#13;
&lt;br&gt;gnas chen brgyad kyi yan lag g+han d+ha la || &#13;
&lt;br&gt;ri de la rten+d pa'i ti nan 'dir || &#13;
&lt;br&gt;ya rabs chos skyong rdo rje pa la khrungs || &#13;
&lt;br&gt;'bangs rnams zhi bas bces pas chab srid ri bas ri bas brtan || &#13;
&lt;br&gt;dkon mchog dbu' dbangs bstod pas | phyi ma byang chub thob || &#13;
&lt;br&gt;nor zas sgyu mar gzigs pas || mdo sde 'gyur 'od bzhengs || &#13;
&lt;br&gt;mchod gnas 'degs pa'i jee Na bzang gnyis dang | &#13;
&lt;br&gt;dam [chos] rgyas par byed pa'i yig mkhan rdo rje rtse || &#13;
&lt;br&gt;thub pas dga' bo mngal mjug bstand pa bzhin || &#13;
&lt;br&gt;bstan+d nas dga' bo dgra bcom thob pa bzhin | &#13;
&lt;br&gt;yom mcho la thub pas chos bstand x [ ? ] rdzogs pa'i byang chub thob par &#13;
&lt;br&gt;shog || || || &#13;
&lt;br&gt;na mo 'gu ru sku thod pa &lt;/i&gt;</note>
